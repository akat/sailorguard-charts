# sailorguard-charts. Copy to .env (ignored by git).

# Image built by the GitHub workflow on every merge to main (nginx only; the
# data lives in the Docker volume).
IMAGE=ghcr.io/<owner>/sailorguard-charts:latest

# Docker server for scripts/upload.sh (SSH user@host with access to `docker`).
SSH_HOST=user@your-docker-host
# Volume that holds tiles and manifest (portainer-stack.yml).
CHARTS_VOLUME=sailorguard-charts-data
