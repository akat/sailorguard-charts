# sailorguard-charts. Copy to .env (ignored by git).

# Images built by the GitHub workflow on every merge to main.
IMAGE=ghcr.io/<owner>/sailorguard-charts:latest
GENERATOR_IMAGE=ghcr.io/<owner>/sailorguard-charts-generator:latest

# Generator (Portainer stack variables): areas from generator/regions.json and
# parallel EMODnet requests.
CHART_AREAS=mediterranean black-sea
CHART_CONCURRENCY=3

# Only for scripts/upload.sh (manual upload of locally built data; optional).
SSH_HOST=user@your-docker-host
CHARTS_VOLUME=sailorguard-charts-data
